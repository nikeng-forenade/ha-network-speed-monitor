# Credentials and endpoints for netflow_to_mqtt.py, read by netflow-to-mqtt.service.
# chmod 600 /etc/netflow-to-mqtt.env

NTOPNG_URL=http://192.168.1.1:3000
NTOPNG_USER=admin
NTOPNG_PASSWORD=change-me

# ifid of the NordVPN interface (see: --list-interfaces)
NTOPNG_IFID=7
POLL_INTERVAL=10
NAMES_FILE=/etc/netflow-to-mqtt-names.json

MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=mqtt
MQTT_PASSWORD=change-me
